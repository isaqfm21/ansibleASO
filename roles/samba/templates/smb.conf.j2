[global]
   workgroup = {{ samba_workgroup }}
   server string = Samba {{ inventory_hostname }}
   security = user
   map to guest = Never
   server min protocol = SMB2
   disable netbios = yes
   smb ports = 445
  log file = /var/log/samba/log.%m
   max log size = 1000
[{{ samba_share_name }}]
   comment = Recurso compartido
   path = {{ samba_share_path }}
   valid users = {{ samba_system_user }}
   force group = {{ samba_group }}
   browseable = yes
   read only = no
   create mask = {{ samba_create_mask }}
   directory mask = {{ samba_directory_mask }}
   force create mode = {{ samba_create_mask }}
   force directory mode = {{ samba_directory_mask }}
